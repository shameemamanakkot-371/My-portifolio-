<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <nav>
        <h2>My Portfolio</h2>

        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>
</header>

<section id="home" class="hero">
    <div>
        <h1>Hello, I'm <span>Ayisha</span></h1>
        <p>Web Developer | Teacher | Online Tutor</p>
        <a href="#contact" class="btn">Contact Me</a>
    </div>
</section>

<section id="about">
    <h2>About Me</h2>
    <p>
        I am interested in web development, teaching and technology.
        I enjoy learning new skills and creating useful websites.
    </p>
</section>

<section id="skills">
    <h2>My Skills</h2>

    <div class="skills-container">
        <div class="skill">HTML</div>
        <div class="skill">CSS</div>
        <div class="skill">JavaScript</div>
        <div class="skill">MS Word</div>
        <div class="skill">Excel</div>
        <div class="skill">Teaching</div>
    </div>
</section>

<section id="contact">
    <h2>Contact Me</h2>

    <form id="contactForm">
        <input type="text" id="name" placeholder="Your Name" required>

        <input type="email" id="email" placeholder="Your Email" required>

        <textarea id="message" placeholder="Your Message" required></textarea>

        <button type="submit">Send Message</button>
    </form>

    <p id="result"></p>
</section>

<footer>
    <p>© 2026 My Portfolio. All Rights Reserved.</p>
</footer>

<script src="script.js"></script>

</body>
</html>
const form = document.getElementById("contactForm");
const result = document.getElementById("result");

form.addEventListener("submit", function (event) {
  event.preventDefault();

  const name = document.getElementById("name").value.trim();
  const email = document.getElementById("email").value.trim();
  const message = document.getElementById("message").value.trim();

  // Check empty fields
  if (!name || !email || !message) {
    result.style.color = "red";
    result.textContent = "Please fill in all fields.";
    return;
  }

  // Basic email pattern check
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailPattern.test(email)) {
    result.style.color = "red";
    result.textContent = "Please enter a valid email address.";
    return;
  }

  // Success response
  result.style.color = "green";
  result.textContent = `Thank you, ${name}! Your message has been sent.`;

  form.reset();
});
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    background: #f5f5f5;
    color: #222;
}

header {
    background: #222;
    padding: 15px 8%;
    position: sticky;
    top: 0;
    z-index: 1000;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav h2 {
    color: white;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 25px;
}

nav a {
    color: white;
    text-decoration: none;
}

nav a:hover {
    text-decoration: underline;
}

.hero {
    min-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 30px;
}

.hero h1 {
    font-size: 45px;
}

.hero span {
    color: #0077cc;
}

.hero p {
    margin: 15px 0;
    font-size: 20px;
}

.btn {
    display: inline-block;
    background: #0077cc;
    color: white;
    padding: 12px 25px;
    border-radius: 6px;
    text-decoration: none;
    margin-top: 10px;
}

section {
    padding: 70px 8%;
    text-align: center;
}

section h2 {
    margin-bottom: 25px;
    font-size: 30px;
}

#about {
    background: white;
}

#about p {
    max-width: 700px;
    margin: auto;
}

.skills-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 800px;
    margin: auto;
}

.skill {
    background: white;
    padding: 25px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

#contact {
    background: white;
}

form {
    max-width: 500px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

input,
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 16px;
}

textarea {
    height: 130px;
    resize: vertical;
}

button {
    padding: 12px;
    border: none;
    border-radius: 5px;
    background: #0077cc;
    color: white;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background: #005fa3;
}

#result {
    margin-top: 15px;
}

footer {
    background: #222;
    color: white;
    text-align: center;
    padding: 20px;
}

@media (max-width: 600px) {

    nav {
        flex-direction: column;
        gap: 10px;
    }

    nav ul {
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero h1 {
        font-size: 32px;
    }

    .skills-container {
        grid-template-columns: 1fr;
    }
}
